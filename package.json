        "site:update": "npx vp-update",
        "build": "npm run pdf && npm run site:build"
    },
    "devDependencies": {
        "@fontsource/open-sans": "^5.3.0",
        "@vuepress/bundler-vite": "^2.0.0-rc.7",
        "@vuepress/theme-default": "^2.0.0-rc.11",
        "js-yaml": "^5.5.0",
        "playwright": "^1.64.1",
        "qrcode": "^1.5.4",
        "sass-embedded": "^1.85.1",
        "vue": "^3.4.0",
        "vuepress": "^2.0.0-rc.7"
    }
}
